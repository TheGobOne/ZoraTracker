<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows tracker's embedded art, in an assembly named "Z1R_WPF" with the same resource names as the real one.
       Gob's Z1R_Sync code finds its sprites by looking for a loaded assembly with exactly that name, and Graphics.GetResourceStream
       reads from it too. Keep this list in sync with the EmbeddedResource items in Z1R_WPF/Z1R_WPF.fsproj. -->
