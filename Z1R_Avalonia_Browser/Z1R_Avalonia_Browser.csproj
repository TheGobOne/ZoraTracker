<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Browser (WebAssembly) build of the tracker: a limited version (PLAN.md, phase 6). It compiles Z1R_Avalonia's own .cs files with BROWSER
       defined (a project reference can't change how they compile: MyWindowBase derives from a stand-in for Window here; see Z1R_Avalonia/Browser.cs).
       One-time setup:  sudo dotnet workload install wasm-tools   (without it the build succeeds, but Skia isn't linked in and the page can't draw)
       Run:  dotnet run in this folder   (prints the local URL)
       Publish a static site:  dotnet publish Z1R_Avalonia_Browser -c Release  (output: bin/Release/net10.0-browser/publish/wwwroot) -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Z1R_Avalonia</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <!-- the settings and save files use System.Text.Json's reflection-based serializer, which WebAssembly builds turn off by default -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- keep .NET's error messages (WebAssembly builds strip them to resource keys by default), so the console shows what went wrong -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>
  <!-- Release (dotnet publish -c Release): compile ahead of time to WebAssembly, so the tracker runs at full speed (Debug interprets .NET code, which
       is several times slower). AOT needs trimming; partial trimming only trims the .NET libraries that allow it, and the tracker's own assemblies and
       the F#/JSON libraries are kept whole, since they use reflection the trimmer can't see. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="Z1R_Avalonia_Browser" />
    <TrimmerRootAssembly Include="Z1R_Tracker_Core" />
    <TrimmerRootAssembly Include="Z1R_SharedInterop" />
    <TrimmerRootAssembly Include="Z1R_Sync" />
    <TrimmerRootAssembly Include="Z1R_WPF" />
    <TrimmerRootAssembly Include="Z1R_Avalonia_DrawingShim" />
    <TrimmerRootAssembly Include="FSharp.Core" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Z1R_Avalonia\*.cs" Link="Z1R_Avalonia\%(Filename)%(Extension)" />
    <!-- the sounds, served next to the page (Platform.PlaySound) -->
    <Content Include="..\Z1R_WPF\reminder_clink.wav" Link="wwwroot\reminder_clink.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Z1R_WPF\confirm_speech.wav" Link="wwwroot\confirm_speech.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the same packages and projects as Z1R_Avalonia, except SharpHook and SDL (native desktop libraries; their code is #if !BROWSER) -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="11.3.22" />
    <!-- a page has no system fonts; Inter stands in for the tracker's fonts (Avalonia's browser template does the same) -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Z1R_Tracker_Core\Z1R_Tracker_Core.fsproj" />
    <ProjectReference Include="..\Z1R_Avalonia_DrawingShim\Z1R_Avalonia_DrawingShim.csproj" />
    <ProjectReference Include="..\Z1R_Avalonia_WPFResources\Z1R_Avalonia_WPFResources.csproj" />
    <ProjectReference Include="..\Z1R_Avalonia_SharedInterop\Z1R_Avalonia_SharedInterop.fsproj" />
    <ProjectReference Include="..\Z1R_Avalonia_Sync\Z1R_Avalonia_Sync.csproj" />
  </ItemGroup>
</Project>
