  <Target Name="PublishSignalRHost" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish ../Z1R_SignalRHost/Z1R_SignalRHost.csproj -c $(Configuration) -r win-x86 --self-contained true -p:PublishSingleFile=true -o ../Z1R_SignalRHost/bin/$(Configuration)/netcoreapp3.1/win-x86/publish" />
  </Target>
  <Target Name="CopySignalRHostExe" AfterTargets="Build">
    <Copy SourceFiles="../Z1R_SignalRHost/bin/$(Configuration)/netcoreapp3.1/win-x86/publish/Z1R_SignalRHost.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
