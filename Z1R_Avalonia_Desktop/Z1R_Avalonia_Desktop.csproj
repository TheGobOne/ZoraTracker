<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop host: Windows / macOS / Linux -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ZoraTracker.CrossPlatform</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- the same logo as the WPF tracker's exe (the .exe's icon in Explorer, the taskbar, Alt+Tab) -->
    <ApplicationIcon>..\Z1R_WPF\icons\ztlogo64x64.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- (the window's own title-bar icon is loaded from this file at startup) -->
    <None Include="..\Z1R_WPF\icons\ztlogo64x64.ico" Link="ztlogo64x64.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Z1R_Avalonia\Z1R_Avalonia.csproj" />
  </ItemGroup>
  <!-- Co-op hosting on macOS and Linux: publishing for one of those systems also publishes the co-op host (Z1R_SignalRHost, no .exe) next to the app.
       Windows is unchanged (the Windows host comes from the WPF build). -->
  <Target Name="PublishCoopHostOffWindows" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Z1R_SignalRHost_Net10\Z1R_SignalRHost_Net10.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained -p:PublishSingleFile=true -o &quot;$(PublishDir)&quot; -v q -nologo" />
  </Target>
</Project>
