<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform tracker UI (C#), ported file by file from Z1R_WPF (F#). See docs/avalonia-port/PLAN.md.
       Every WPF file X.fs becomes X.cs here, as a static class X with the same members in the same order. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Z1R_Avalonia</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- the F# versions of already-ported files, kept only until their C# conversion lands -->
  <ItemGroup>
    <None Remove="*.fs" />
  </ItemGroup>

  <!-- files that ship next to the app, as in the Windows tracker -->
  <ItemGroup>
    <None Include="..\Z1R_WPF\reminder_clink.wav" Link="reminder_clink.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Z1R_WPF\confirm_speech.wav" Link="confirm_speech.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Z1R_WPF\ShowRunCustomImages\*.png" Link="ShowRunCustomImages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Z1R_Tracker\README.txt" Link="README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- speech synthesis on Windows (WPF: the System.Speech framework assembly). Builds everywhere; only called when OperatingSystem.IsWindows()
         (Platform.SpeechSynthesizer); off Windows the package's assembly throws PlatformNotSupportedException, so it's never touched there. -->
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <!-- global hotkeys and fake mouse input on every OS (libuiohook; Platform.RegisterHotKey, Platform.LeftMouseClick, ...) -->
    <PackageReference Include="SharpHook" Version="8.0.1" />
    <!-- sound and the gamepad on every OS (SDL3 with its native libraries; Platform.PlaySound, Gamepad) -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- the shared tracker model (Gob's F#, used unchanged) -->
    <ProjectReference Include="..\Z1R_Tracker_Core\Z1R_Tracker_Core.fsproj" />
    <!-- System.Drawing stand-in, the "Z1R_WPF" art assembly, and net10 builds of Gob's Z1R_Sync and Z1R_SharedInterop (see PROGRESS.md) -->
    <ProjectReference Include="..\Z1R_Avalonia_DrawingShim\Z1R_Avalonia_DrawingShim.csproj" />
    <ProjectReference Include="..\Z1R_Avalonia_WPFResources\Z1R_Avalonia_WPFResources.csproj" />
    <ProjectReference Include="..\Z1R_Avalonia_SharedInterop\Z1R_Avalonia_SharedInterop.fsproj" />
    <ProjectReference Include="..\Z1R_Avalonia_Sync\Z1R_Avalonia_Sync.csproj" />
  </ItemGroup>

</Project>
